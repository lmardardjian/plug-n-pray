# =========================
# CONFIG CPU
# IP_CPU   por default 127.0.0.1
# PUERTO_CPU   no tiene (no escucha)
# =========================

# Dirección del Kernel Scheduler
IP_KERNEL_SCHEDULER=127.0.0.1
PUERTO_KERNEL_SCHEDULER=8000

# Dirección del Kernel Memory
IP_KERNEL_MEMORY=127.0.0.1
PUERTO_KERNEL_MEMORY=8001

# Dirección del Memory Stick
IP_MEMORY_STICK=127.0.0.1
PUERTO_MEMORY_STICK=8003

# Nivel de log (INFO, DEBUG, ERROR)
LOG_LEVEL=INFO